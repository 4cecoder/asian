# env
.env*
!.env.example

# vercel / netlify
.vercel
.netlify

# convex — schema/functions code is fine to publish; deployment data and
# local dev state are not. See SECURITY.md.
#
# convex/_generated/ is DELIBERATELY NOT ignored, despite looking like a
# build artifact — this was gitignored initially (wrong: assumed it was
# like .next/ or a generated Xcode project) until CI failed with "Cannot
# find module './_generated/api'". Convex's own `codegen --help` says
# outright: "should be committed to the repo (your code won't typecheck
# without it!)" — and unlike a truly regenerate-anywhere artifact,
# regenerating it requires a live, authenticated Convex connection
# (`bunx convex codegen` fails outright with no CONVEX_DEPLOYMENT set),
# so CI can't cheaply regenerate it on every run the way it can rerun
# `xcodegen generate`. Commit it.
.convex/
*.convex.local
.auth-keys.json
# regenerated from convex/seed/build-*.ts — large, and identical output
# from the same public source, so not worth tracking in git
apps/web/convex/seed/*.jsonl

# android / gradle
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
apps/android/.idea/
apps/android/*.iml
apps/android/captures/
apps/android/.cxx/

# ios / xcode — Asian.xcodeproj is generated from project.yml by xcodegen,
# not committed (avoids pbxproj merge conflicts, same idea as apps/android/build/)
apps/ios/*.xcodeproj/
apps/ios/*.xcworkspace/
apps/ios/DerivedData/
apps/ios/.build/
apps/ios/.swiftpm/
apps/ios/xcuserdata/
apps/ios/*.xcuserstate

# typescript
*.tsbuildinfo
next-env.d.ts

# turborepo
.turbo/

# playwright
apps/web/playwright-report/
apps/web/test-results/
apps/web/blob-report/

# editors
.vscode/*
!.vscode/extensions.json
.idea/
