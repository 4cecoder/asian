# dependencies
node_modules/
.pnp
.pnp.js

# next.js
apps/*/.next/
apps/*/out/

# production
apps/*/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# env
.env*
!.env.example

# vercel / netlify
.vercel
.netlify

# convex — schema/functions code is fine to publish; deployment data,
# generated bindings, and local dev state are not. See SECURITY.md.
convex/_generated/
.convex/
*.convex.local

# android / gradle
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
apps/android/.idea/
apps/android/*.iml
apps/android/captures/
apps/android/.cxx/

# ios / xcode — Asian.xcodeproj is generated from project.yml by xcodegen,
# not committed (avoids pbxproj merge conflicts, same idea as apps/android/build/)
apps/ios/*.xcodeproj/
apps/ios/*.xcworkspace/
apps/ios/DerivedData/
apps/ios/.build/
apps/ios/.swiftpm/
apps/ios/xcuserdata/
apps/ios/*.xcuserstate

# typescript
*.tsbuildinfo
next-env.d.ts

# turborepo
.turbo/

# playwright
apps/web/playwright-report/
apps/web/test-results/
apps/web/blob-report/

# editors
.vscode/*
!.vscode/extensions.json
.idea/
